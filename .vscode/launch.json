{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CC Beacon (both extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/notifier",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/core"
      ],
      "outFiles": ["${workspaceFolder}/packages/*/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
