{
  "name": "cc-beacon-repo",
  "private": true,
  "description": "CC Beacon: alerts when Claude Code needs you. Builds two local VS Code extensions.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "build:helper": "sh packages/notifier/native/darwin/build.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "package": "node scripts/package.mjs",
    "install-local": "node scripts/install-local.mjs",
    "fake-claude": "node scripts/fake-claude.mjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
