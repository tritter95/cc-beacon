{
  "name": "cc-beacon-notifier",
  "displayName": "CC Beacon Notifier",
  "description": "Shows CC Beacon's OS notifications and plays its sounds. Runs on your local machine, also for remote windows.",
  "version": "0.1.0",
  "publisher": "todd",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:ccBeacon.notifier.capabilities",
    "onCommand:ccBeacon.notifier.notify",
    "onCommand:ccBeacon.notifier.withdraw",
    "onCommand:ccBeacon.notifier.playSound",
    "onCommand:ccBeacon.notifier.requestPermission",
    "onCommand:ccBeacon.notifier.openSettings"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
